generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  role              Role     @relation(fields: [roleId], references: [id])
  roleId            String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  projectAssignments ProjectAssignment[]
  auditLogs         AuditLog[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  users       User[]
  permissions Permission[]
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  role        Role?  @relation(fields: [roleId], references: [id])
  roleId      String?
}

model Client {
  id          String    @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  projects    Project[]
  createdAt   DateTime  @default(now())
}

model Project {
  id                  String            @id @default(cuid())
  name                String
  code                String            @unique
  location            String
  siteAddress         String?
  clientId            String?
  client              Client?           @relation(fields: [clientId], references: [id])
  projectType         String?
  description         String?
  startDate           DateTime?
  expectedCompletion  DateTime?
  currentStage        String?
  status              String            @default("draft")
  contractValue       Decimal?
  projectBudget       Decimal?
  labourBudget        Decimal?
  initialProgress     Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  assignments         ProjectAssignment[]
  workers             Worker[]
  dailyReports        DailyReport[]
  materials           Material[]
  inventoryTransactions InventoryTransaction[]
  issues              Issue[]
  safetyRecords       SafetyRecord[]
  equipment           Equipment[]
  documents           Document[]
}

model ProjectAssignment {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  role          String
  assignedAt    DateTime @default(now())
  revokedAt     DateTime?
  notificationSent Boolean @default(false)
  @@unique([projectId, userId, role])
}

model Worker {
  id                String        @id @default(cuid())
  fullName          String
  nationalId        String?
  phone             String?
  jobTrade          String?
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id])
  dateJoined        DateTime?
  profilePhoto      String?
  employmentStatus  String        @default("active")
  emergencyContact  String?
  emergencyPhone    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  rates             WorkerRate[]
  attendance        Attendance[]
  workingHours      WorkingHour[]
}

model WorkerRate {
  id            String   @id @default(cuid())
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id])
  hourlyRate    Decimal?
  dailyRate     Decimal?
  overtimeRate  Decimal?
  standardHours Int?
  rateType      String
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
}

model Attendance {
  id          String   @id @default(cuid())
  workerId    String
  worker      Worker   @relation(fields: [workerId], references: [id])
  projectId   String
  date        DateTime
  status      String
  notes       String?
  createdAt   DateTime @default(now())
}

model WorkingHour {
  id            String   @id @default(cuid())
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id])
  projectId     String
  date          DateTime
  startTime     DateTime?
  endTime       DateTime?
  breakMinutes  Int      @default(0)
  regularHours  Decimal  @default(0)
  overtimeHours Decimal  @default(0)
  status        String   @default("draft")
  approvedAt     DateTime?
  createdAt     DateTime @default(now())
}

model DailyReport {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id])
  reportNumber        String
  date                DateTime
  supervisorId        String?
  weather             String?
  siteConditions     String?
  workCompleted       String?
  workPlanned         String?
  workersPresent      Int      @default(0)
  workersAbsent       Int      @default(0)
  totalHours          Decimal?
  labourCost          Decimal?
  status              String   @default("draft")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Material {
  id                  String    @id @default(cuid())
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id])
  name                String
  quantity            Decimal
  unit                String
  purpose             String?
  supplier            String?
  deliveryDate        DateTime?
  cost                Decimal?
  condition           String?
  deliveryNote        String?
  photo               String?
  remarks             String?
  createdAt           DateTime  @default(now())
}

model InventoryTransaction {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  materialName  String
  quantity      Decimal
  type          String
  remarks       String?
  createdAt     DateTime @default(now())
}

model Issue {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  title         String
  description   String
  category      String
  priority      String
  status        String   @default("open")
  reportedBy    String?
  assignedTo    String?
  createdAt     DateTime @default(now())
}

model Equipment {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  name            String
  serialNumber    String?
  operator        String?
  condition       String?
  operatingHours  Decimal?
  fuelUsage       Decimal?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime @default(now())
}

model SafetyRecord {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String
  severity    String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  category    String?
  fileUrl     String
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  projectId   String?
  details     String?
  createdAt   DateTime @default(now())
}
